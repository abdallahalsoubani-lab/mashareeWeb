# Production Environment Variables
# انسخ هذا الملف إلى .env على السيرفر

# Node Environment
NODE_ENV=production

# Database Configuration
# لا تغير هذا إلا إذا غيرت إعدادات docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@db:5432/masharee

# JWT Secret - IMPORTANT: Generate a new secret!
# استخدم هذا الأمر لتوليد مفتاح جديد:
# openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_32_CHARS_MIN

# Application Port
PORT=3000

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=1
HOSTNAME=0.0.0.0

# ===================================================
# اختياري: إعدادات إضافية للإنتاج
# ===================================================

# Logging
# LOG_LEVEL=info

# CORS (إذا احتجت)
# ALLOWED_ORIGINS=http://34.136.2.116,https://yourdomain.com

# Rate Limiting
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=15m

# ===================================================
# ملاحظات مهمة:
# ===================================================
# 1. غير JWT_SECRET قبل الاستخدام!
# 2. لا تشارك هذا الملف في Git
# 3. احتفظ بنسخة احتياطية آمنة
# 4. راجع إعدادات قاعدة البيانات
