generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== ENUMS ==========

enum UserRole {
  ADMIN
  INVESTOR
}

enum InvestmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  INVEST
  RETURN
  DIVIDEND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

// ========== MODELS ==========

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  phone        String?      @unique
  passwordHash String
  name         String
  role         UserRole     @default(INVESTOR)
  isVerified   Boolean      @default(false)
  avatar       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  investments  Investment[]
  wallet       Wallet?
  auditLogs    AdminAuditLog[]

  @@index([email])
}

model Project {
  id              String   @id @default(cuid())
  type            String   // صندوق عقاري، صكوك، تمويل جماعي، مساهمة عقارية
  title           String
  description     String?  @db.Text
  location        String
  image           String
  images          String[] // معرض الصور
  badges          String[] // جديد، مميز، حصري، عوائد دورية، متوافق مع الشريعة
  expectedReturn  Float    // نسبة العائد المتوقع
  durationMonths  Int      // مدة الاستثمار بالأشهر
  minimumAmount   Float    // الحد الأدنى للاستثمار
  unitPrice       Float?   // سعر الوحدة
  riskLevel       String   // منخفضة، متوسطة، متوسطة-عالية، عالية
  targetAmount    Float    // المبلغ المستهدف
  fundedAmount    Float    @default(0) // المبلغ المجموع
  daysRemaining   Int?     // الأيام المتبقية
  category        String   // سكني، تجاري، صناعي، فندقي
  fundManager     String?  // مدير الصندوق
  distributor     String?  // موزع الوحدات
  supervisor      String?  // الرقابة
  distributionPolicy String? // سياسة التوزيع
  status          String   @default("active") // active, completed, cancelled
  isActive        Boolean  @default(true)
  latitude        Float?   // إحداثيات الموقع
  longitude       Float?
  attachments     Json?    // المرفقات PDF
  boardMembers    Json?    // أعضاء مجلس الإدارة
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  investments     Investment[]

  @@index([status])
  @@index([category])
}

model Investment {
  id          String           @id @default(cuid())
  userId      String
  projectId   String
  amount      Float
  units       Int?             // عدد الوحدات
  status      InvestmentStatus @default(PENDING)
  returns     Float            @default(0) // العوائد المحققة
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

model Wallet {
  id           String        @id @default(cuid())
  userId       String        @unique
  balance      Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id          String            @id @default(cuid())
  walletId    String
  type        TransactionType
  amount      Float
  status      TransactionStatus @default(PENDING)
  reference   String?           // رقم مرجعي
  description String?
  projectId   String?           // في حالة الاستثمار
  createdAt   DateTime          @default(now())

  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String
  action       String   // CREATE, UPDATE, DELETE
  entity       String   // User, Project, Investment
  entityId     String
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  admin        User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entity])
  @@index([createdAt])
}
